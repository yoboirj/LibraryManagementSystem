@page "/browse-books"
@attribute [Authorize(Roles = "Member")]
@using LibraryManagementSystem.Features.Data.Models
@using LibraryManagementSystem.Features.Services.Intefaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IBookServices BookServices
@inject IBorrowServices BorrowServices
@inject IMemberServices MemberServices
@inject IAuthorServices AuthorServices
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">
    <div class="d-flex align-center justify-space-between mb-8">
        <MudText Typo="Typo.h4">Browse Books</MudText>
    </div>

    <!-- REMOVED the foreach loop that was causing the error -->

    <MudTable Items="@books" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="4" Filter="new Func<Book, bool>(FilterFunc)" Loading="@loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Available Books</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="searchString" Placeholder="Search Title or Author" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Author</MudTh>
            <MudTh>Available Quantity</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Author">@context.Author?.Name</MudTd>
            <MudTd DataLabel="Available Quantity">
                <MudText Color="@(context.Quantity > 0 ? Color.Success : Color.Error)">
                    @context.Quantity
                </MudText>
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => OpenBorrowDialog(context))"
                           Disabled="@(context.Quantity <= 0)">
                    Borrow
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No books available at the moment.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading books...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

<MudDialog @bind-Visible="isBorrowDialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Borrow Book</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>You are borrowing <b>@borrowingBook.Title</b> by @borrowingBook.Author?.Name</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">Available: <b>@borrowingBook.Quantity</b> copy(s)</MudText>

        <MudNumericField T="int?" @bind-Value="borrowQuantity"
                         Label="Quantity to Borrow"
                         Placeholder="Enter quantity"
                         Min="1"
                         Max="@borrowingBook.Quantity"
                         Required="true"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="CancelBorrow">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="HandleBorrow"
                   Disabled="@(borrowQuantity <= 0 || borrowQuantity > borrowingBook.Quantity)">
            Confirm Borrow
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    List<Book> books = new();
    string searchString = "";
    bool loading = true;

    // Borrow logic
    bool isBorrowDialogVisible;
    Book borrowingBook = new();
    int? borrowQuantity;
    DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    { 
        await LoadBooks();
    }

    private async Task LoadBooks()
    {
        loading = true;
        books = await BookServices.GetBooksWithAuthorsAsync();
        loading = false;
    }

    private bool FilterFunc(Book book)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (book.Title.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (book.Author?.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        return false;
    }

    private void OpenBorrowDialog(Book book)
    {
        borrowingBook = book;
        borrowQuantity = null;
        isBorrowDialogVisible = true;
    }

    private void CancelBorrow()
    {
        isBorrowDialogVisible = false;
    }

    private async Task HandleBorrow()
    {
        if (borrowQuantity == null || borrowQuantity <= 0 || borrowQuantity > borrowingBook.Quantity)
        {
            Snackbar.Add("Please enter a valid quantity.", Severity.Warning);
            return;
        }

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var username = user.Identity?.Name;

            if (string.IsNullOrEmpty(username))
            {
                Snackbar.Add("User not authenticated.", Severity.Error);
                return;
            }

            var allMembers = await MemberServices.GetAllMembersAsync();
             var member = allMembers.FirstOrDefault(m => m.Name == username);
             if (member == null)
             {
                 Snackbar.Add("Member record not found.", Severity.Error);
                 return;
             }

            var borrow = new Borrow
            {
                BookId = borrowingBook.Id,
                MemberId = member.Id,
                Quantity = borrowQuantity.Value,
                BorrowedAt = DateTimeOffset.Now,
                DueDate = DateTimeOffset.Now.AddDays(14),
                Title = borrowingBook.Title,
                Author = borrowingBook.Author?.Name ?? "Unknown"
            };

            await BorrowServices.CreateBorrowAsync(borrow);
            Snackbar.Add($"Successfully borrowed {borrowQuantity} copy(s) of {borrowingBook.Title}", Severity.Success);
            isBorrowDialogVisible = false;
            await LoadBooks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}