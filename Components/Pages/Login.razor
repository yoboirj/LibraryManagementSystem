@page "/login"
@layout LibraryManagementSystem.Components.Layout.AuthLayout
@inject NavigationManager NavManager
@inject IUserServices UserServices
@inject ISnackbar Snackbar
@inject AuthStateProvider AuthStateProvider

<MudPaper Elevation="4" Class="pa-8" Style="max-width: 400px; width: 100%; margin: auto;">
    <div class="d-flex flex-column align-center mb-6">
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Style="font-size: 4rem;" />
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mt-2">Library System</MudText>
        <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Sign in</MudText>
    </div>
    <MudForm @ref="form" @bind-IsValid="@success">
        <MudTextField T="string" Label="Username" Required="true" RequiredError="Username is required!"
                      @bind-Value="username" Variant="Variant.Outlined" Margin="Margin.Dense" 
                      ShrinkLabel="true" Immediate="true" />
        <MudTextField T="string" Label="Password" Required="true" RequiredError="Password is required!"
                      InputType="InputType.Password" @bind-Value="password" Class="mt-4" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Immediate="true" />

        @if (!string.IsNullOrEmpty(error))
        {
            <MudText Color="Color.Error" Class="mt-2" Typo="Typo.body2">@error</MudText>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="HandleLogin" Class="mt-6 py-3">Login</MudButton>

        <MudText Align="Align.Center" Class="mt-4">
            Don't have an account? <MudLink Href="/register">Register</MudLink>
        </MudText>
    </MudForm>
</MudPaper>

@code {
    bool success;
    MudForm form = default!;
    string username = string.Empty;
    string password = string.Empty;
    string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;

        if (currentUser.Identity != null && currentUser.Identity.IsAuthenticated)
        {
            NavManager.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        await form.ValidateAsync();

        if (form.IsValid)
        {
            var user = await UserServices.LoginAsync(username, password);
            if (user != null)
            {
                AuthStateProvider.MarkUserAsAuthenticated(user);
                Snackbar.Add($"Welcome back, {user.Username}!", Severity.Success);
                NavManager.NavigateTo("/");
            }
            else
            {
                error = "Invalid username or password.";
            }
        }
    }
}